          {
            "author": { "displayName": "Maya Rao" },
            "created": "2024-09-28T09:45:00.000+0000",
            "body": "<p>Fixed in 2.1.4. The VAT rounding path was corrected; exports verified with finance.</p>"
          }
        ]
