    {
      "key": "LUM-804",
      "self": "https://lumen.atlassian.net/rest/api/2/issue/LUM-804",
      "fields": {
        "summary": "KESTREL refactor: billing-v2 module",
        "created": "2024-09-10T09:00:00.000+0000",
        "reporter": {
          "displayName": "Alex Weinstein"
        },
        "comment": {
          "comments": [
            {
              "created": "2024-09-22T16:20:00.000+0000",
              "author": {
                "displayName": "Nadia Chen"
              },
              "body": "<p>Follow-up while triaging LUM-811: the KESTREL refactor (billing-v2) moved VAT rounding to integer math in 5.3.0, which drops fractional cents and blanks the totals on export. That change is still unreviewed.</p>"
            }
          ]
        }
      }
    }
