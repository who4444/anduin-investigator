      "fields": {
        "summary": "VAT invoice exports show blank totals",
        "created": "2024-09-02T08:40:00.000+0000",
        "reporter": {
          "displayName": "Dana Okafor"
        },
        "comment": {
          "comments": [
            {
              "created": "2024-09-02T09:10:00.000+0000",
              "author": {
                "displayName": "Priya Nair"
              },
              "body": "<p>Received via finance call. Exports to the VAT format produce empty Total columns since the 5.3.0 upgrade.</p>"
            },
            {
              "created": "2024-09-18T11:20:00.000+0000",
              "author": {
                "displayName": "Ravi Menon"
              },
              "body": "<p>Fix is scheduled for the Sep 20 release. Please confirm which finance sandbox the export came from.</p>"
            },
            {
              "created": "2024-09-21T10:05:00.000+0000",
              "author": {
                "displayName": "Priya Nair"
              },
              "body": "<p>Resolved with the 5.3.3 rollout; exports verified on our side. Flagging as done.</p>"
            },
            {
              "created": "2024-09-26T14:32:00.000+0000",
              "author": {
                "displayName": "Nadia Chen"
              },
              "body": "<p>Reopened after re-checking the finance sandbox: totals still blank on VAT layouts.</p>"
            },
            {
              "created": "2024-09-28T09:45:00.000+0000",
              "author": {
                "displayName": "Nadia Chen"
              },
              "body": "<p>Fixed in 5.3.4. VAT rounding path corrected; exports verified with finance.</p>"
            }
          ]
        }
