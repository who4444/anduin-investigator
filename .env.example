DATABASE_URL=postgres://anduin:anduin@localhost:5432/anduin
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Live pulls (optional — leave blank to disable a source)
JIRA_SITE=
JIRA_EMAIL=
JIRA_API_TOKEN=
SLACK_TOKEN=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_QUERY=
GMAIL_MAX_MESSAGES=200
# Optional hide lists: keep workspace noise out of the default source list on
# the landing page (hidden items stay discoverable via the search box).
JIRA_HIDDEN_PROJECTS=
SLACK_HIDDEN_CHANNELS=
# On Vercel, the Neon integration injects DATABASE_URL (pooled) and
# DATABASE_URL_UNPOOLED (direct; use it for `npm run db:migrate`).
